# Copy this file to .env and fill in your key:  cp .env.example .env
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Port the web server listens on
PORT=3000

# Gemini model to use, plus comma-separated fallbacks tried in order when it is
# overloaded, rate-limited or unavailable. The "-latest" aliases always point to
# Google's newest Flash / Flash-Lite models.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Image mode (🎨). Image models usually need billing enabled in Google AI Studio -
# on the free tier they return a quota error.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-lite-image

# Suggested follow-up questions under each answer (one small extra request per reply).
FOLLOW_UP_SUGGESTIONS=true
GEMINI_SUGGESTIONS_MODEL=gemini-flash-lite-latest

# Maximum length of a single reply, in tokens
MAX_TOKENS=8192

# Chat requests allowed per IP address per minute
RATE_LIMIT_PER_MINUTE=30
